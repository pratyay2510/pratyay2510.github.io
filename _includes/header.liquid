<header>
  <nav
    id="navbar"
    class="navbar navbar-light navbar-expand-sm prerana-navbar {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}"
    role="navigation"
  >
    <div class="container navbar-container">
      <a class="navbar-brand title font-weight-lighter nav-brand-prem" href="{{ '/' | relative_url }}">PRATYAY</a>

      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
        {% assign home_link = '/' | relative_url %}
        {% if page.permalink == '/' %}
          {% assign hero_link = '#hero' %}
          {% assign experience_link = '#experience' %}
          {% assign education_link = '#education' %}
          {% assign publications_link = '#publications' %}
          {% assign skills_link = '#skills' %}
          {% assign projects_link = '#projects' %}
          {% assign contact_link = '#contact' %}
        {% else %}
          {% assign hero_link = '/#hero' | relative_url %}
          {% assign experience_link = '/#experience' | relative_url %}
          {% assign education_link = '/#education' | relative_url %}
          {% assign publications_link = '/#publications' | relative_url %}
          {% assign skills_link = '/#skills' | relative_url %}
          {% assign projects_link = '/#projects' | relative_url %}
          {% assign contact_link = '/#contact' | relative_url %}
        {% endif %}

        <ul class="navbar-nav flex-nowrap home-nav-links">
          <li class="nav-item"><a class="nav-link section-link" href="{{ hero_link }}">About</a></li>
          <li class="nav-item"><a class="nav-link section-link" href="{{ experience_link }}">Experience</a></li>
          <li class="nav-item"><a class="nav-link section-link" href="{{ education_link }}">Education</a></li>
          <li class="nav-item"><a class="nav-link section-link" href="{{ publications_link }}">Publications</a></li>
          <li class="nav-item"><a class="nav-link section-link" href="{{ skills_link }}">Skills</a></li>
          <li class="nav-item"><a class="nav-link section-link" href="{{ projects_link }}">Projects</a></li>
          <li class="nav-item"><a class="nav-link section-link" href="{{ contact_link }}">Contact</a></li>
          <li class="nav-item {% if page.permalink == '/teaching/' %}active{% endif %}"><a class="nav-link" href="{{ '/teaching/' | relative_url }}">Teaching</a></li>
          <li class="nav-item {% if page.permalink == '/more-of-me/' %}active{% endif %}"><a class="nav-link" href="{{ '/more-of-me/' | relative_url }}">More of Me</a></li>
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>

{% if page.permalink == '/' %}
  <script>
    (function () {
      var links = Array.from(document.querySelectorAll('.section-link'));

      /* Smooth scroll on click */
      links.forEach(function (link) {
        link.addEventListener('click', function (e) {
          var href = link.getAttribute('href');
          if (!href || !href.startsWith('#')) return;
          var target = document.querySelector(href);
          if (!target) return;
          e.preventDefault();
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        });
      });

      /* Scroll-position active-link tracking */
      var navbarH = document.getElementById('navbar') ? document.getElementById('navbar').offsetHeight : 60;

      function getActiveSectionId() {
        /* Collect all anchored sections */
        var sections = links
          .map(function (l) { return document.querySelector(l.getAttribute('href')); })
          .filter(Boolean);

        var scrollY = window.scrollY || window.pageYOffset;
        var offset = navbarH + 20;

        /* Walk from bottom up — first section whose top is above (scrollY + offset) wins */
        var active = sections[0];
        for (var i = 0; i < sections.length; i++) {
          if (sections[i].getBoundingClientRect().top + scrollY - offset <= scrollY) {
            active = sections[i];
          }
        }
        return active ? active.id : null;
      }

      function updateNav() {
        var activeId = getActiveSectionId();
        links.forEach(function (l) {
          var href = l.getAttribute('href');
          if (href && href === '#' + activeId) {
            l.classList.add('is-active');
          } else {
            l.classList.remove('is-active');
          }
        });
      }

      /* Set initial state */
      updateNav();

      /* Throttled scroll handler */
      var ticking = false;
      window.addEventListener('scroll', function () {
        if (!ticking) {
          window.requestAnimationFrame(function () { updateNav(); ticking = false; });
          ticking = true;
        }
      }, { passive: true });
    })();
  </script>
{% endif %}
