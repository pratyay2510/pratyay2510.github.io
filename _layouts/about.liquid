---
layout: default
---
<div class="home-sections page-float-in">
  <section id="hero" class="hero-section hero-section-premium">
    <div class="hero-bg-text" aria-hidden="true">VISION</div>

    <div class="hero-content">
      <div class="hero-left reveal-left">
        <div class="hero-label">Portfolio · 2026</div>

        <h1 class="hero-name hero-name-premium">
          <span class="hero-name-first">{{ site.first_name }}</span>
          <span class="hero-name-last">{{ site.last_name }}</span>
        </h1>

        <div class="hero-title-tag">Ph.D. Candidate · Computer Science · UC Riverside</div>
        <div class="hero-divider"></div>

        <div class="hero-bio">
          {{ content }}
        </div>

        <blockquote class="hero-quote">
          "Stay Hungry. Stay Foolish"
        </blockquote>

        <nav class="hero-links" aria-label="Contact links">
          {% assign socials = site.data.socials %}
          {% if socials.linkedin_username %}
            <a class="hero-link" href="https://www.linkedin.com/in/{{ socials.linkedin_username }}" target="_blank" rel="noopener noreferrer">
              <i class="fa-brands fa-linkedin"></i>
              LinkedIn
            </a>
          {% endif %}
          {% if socials.scholar_userid %}
            <a class="hero-link" href="https://scholar.google.com/citations?user={{ socials.scholar_userid }}" target="_blank" rel="noopener noreferrer">
              <i class="ai ai-google-scholar"></i>
              Scholar
            </a>
          {% endif %}
          {% if socials.email %}
            <a class="hero-link" href="mailto:{{ socials.email }}">
              <i class="fa-solid fa-envelope"></i>
              Email
            </a>
          {% endif %}
          {% if socials.cv_pdf %}
            <a class="hero-link" href="{{ socials.cv_pdf | relative_url }}" target="_blank" rel="noopener noreferrer" download="resume-research.pdf">
              <i class="fa-solid fa-file-pdf"></i>
              CV
            </a>
          {% endif %}
        </nav>
      </div>

      <div class="hero-right reveal-right">
        {% if page.profile and page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          <div class="hero-photo-frame">
            <div class="hero-photo-inner">
              <img
                src="{{ profile_image_path | relative_url | bust_file_cache }}"
                alt="{{ site.first_name }} {{ site.last_name }}"
                class="hero-profile-img hero-profile-premium"
              >
            </div>
            <div class="hero-photo-accent" aria-hidden="true"></div>
          </div>
        {% endif %}

        <div class="hero-stats reveal-up" style="--delay:0.3s">
          <div class="stat-item">
            <div class="stat-num">5+</div>
            <div class="stat-label">Papers</div>
          </div>
          <div class="stat-sep" aria-hidden="true"></div>
          <div class="stat-item">
            <div class="stat-num">6+</div>
            <div class="stat-label">Years Experience</div>
          </div>
          <div class="stat-sep" aria-hidden="true"></div>
          <div class="stat-item">
            <div class="stat-num">5</div>
            <div class="stat-label">Courses Taught</div>
          </div>
        </div>
      </div>
    </div>

    <div class="hero-scroll-hint" aria-hidden="true">
      <span>Scroll to explore</span>
      <div class="scroll-line"></div>
    </div>
  </section>

  <section id="education" class="education-showcase-section">
    <div class="section-header reveal-up">
      <div class="section-label">Education</div>
      <h2 class="section-title">Academic Background</h2>
      <div class="section-rule"></div>
    </div>

    <div class="education-grid">
      <div class="edu-card edu-card--primary reveal-up" style="--delay:0s">
        <div class="edu-card-year">2023 - Present</div>
        <div class="edu-card-body">
          <h3 class="edu-card-degree">Doctor of Philosophy (Ph.D.)</h3>
          <div class="edu-card-major">Computer Science</div>
          <div class="edu-card-inst">University of California, Riverside</div>
          <div class="edu-card-detail">Grade: 3.94/4.0</div>
          <div class="edu-card-badge">Currently Pursuing</div>
        </div>
        <div class="edu-card-gpa">
          <div class="edu-gpa-ring">
            <svg viewBox="0 0 80 80" aria-hidden="true">
              <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="4" opacity="0.2"></circle>
              <circle
                class="gpa-arc"
                cx="40"
                cy="40"
                r="34"
                fill="none"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
                stroke-dasharray="213.6"
                stroke-dashoffset="213.6"
                data-offset="3.2"
              ></circle>
            </svg>
            <div class="edu-gpa-val">3.94</div>
          </div>
        </div>
      </div>

      <div class="edu-card reveal-up" style="--delay:0.15s">
        <div class="edu-card-year">2019 - 2023</div>
        <div class="edu-card-body">
          <h3 class="edu-card-degree">Bachelor of Engineering</h3>
          <div class="edu-card-major">Electronics and Telecommunication Engineering</div>
          <div class="edu-card-inst">Jadavpur University</div>
          <div class="edu-card-detail">Grade: 9.5/10</div>
        </div>
        <div class="edu-card-gpa">
          <div class="edu-gpa-ring">
            <svg viewBox="0 0 80 80" aria-hidden="true">
              <circle cx="40" cy="40" r="34" fill="none" stroke="currentColor" stroke-width="4" opacity="0.2"></circle>
              <circle
                class="gpa-arc"
                cx="40"
                cy="40"
                r="34"
                fill="none"
                stroke="currentColor"
                stroke-width="4"
                stroke-linecap="round"
                stroke-dasharray="213.6"
                stroke-dashoffset="213.6"
                data-offset="10.7"
              ></circle>
            </svg>
            <div class="edu-gpa-val">9.5</div>
          </div>
        </div>
      </div>

      <div class="edu-card reveal-up" style="--delay:0.3s">
        <div class="edu-card-year">2005 - 2019</div>
        <div class="edu-card-body">
          <h3 class="edu-card-degree">Primary, Middle and High School</h3>
          <div class="edu-card-major">ICSE and ISC</div>
          <div class="edu-card-inst">Calcutta Boys' School</div>
          <div class="edu-card-detail">Class 10 (ICSE): 99.2% · Class 12 (ISC): 98.75%</div>
        </div>
        <div class="edu-card-scores">
          <div class="score-bar-wrap">
            <div class="score-label">Class X</div>
            <div class="score-bar">
              <div class="score-fill" style="--pct:99.2%"></div>
            </div>
            <div class="score-val">99.2%</div>
          </div>
          <div class="score-bar-wrap">
            <div class="score-label">Class XII</div>
            <div class="score-bar">
              <div class="score-fill" style="--pct:98.75%"></div>
            </div>
            <div class="score-val">98.75%</div>
          </div>
        </div>
      </div>
    </div>
  </section>

    <!-- ── Publications ─────────────────────────────────────────────────── -->
    <div id="publications" class="pub-section" data-aos="fade-up">
      <h3>Publications</h3>
      <div class="pub-timeline">

        <a href="https://scholar.google.com/citations?user=TxKX5p8AAAAJ" target="_blank" rel="noopener noreferrer" class="pub-item" data-aos="fade-left" data-aos-delay="100">
          <div class="pub-img-wrap">
            <i class="fa-solid fa-fire pub-img-icon"></i>
          </div>
          <div class="pub-content">
            <span class="pub-abbr">TPAMI: Under Review</span>
            <p class="pub-title">SAKE: Structure Aware Kernel Experts for Event-Based Object Detection</p>
            <p class="pub-authors">Pratyay Dutta, Bir Bhanu</p>
            <p class="pub-abstract">SAKE replaces heavy AI calculations with a heat-flow mechanism that mimics how information spreads along the edges of objects. This physics-inspired approach allows the model to "see" clearly in low light or fast motion with much less computing power.</p>
          </div>
          <span class="pub-year">2025</span>
        </a>

        <a href="https://ieeexplore.ieee.org/abstract/document/11278837" target="_blank" rel="noopener noreferrer" class="pub-item" data-aos="fade-left" data-aos-delay="150">
          <div class="pub-img-wrap">
            <i class="fa-solid fa-eye pub-img-icon"></i>
          </div>
          <div class="pub-content">
            <span class="pub-abbr">TBIOM 2025</span>
            <p class="pub-title">POANet: Parts-based Occlusion Aware Network for Person Re-ID</p>
            <p class="pub-authors">Pratyay Dutta, Padmaja Jonnalagedda, Bir Bhanu</p>
            <p class="pub-abstract">A parts-based occlusion-aware network for robust person re-identification, addressing partial visibility through structured part-level feature learning and attention-guided reconstruction.</p>
          </div>
          <span class="pub-year">2025</span>
        </a>

        <a href="https://ieeexplore.ieee.org/document/11475505" target="_blank" rel="noopener noreferrer" class="pub-item" data-aos="fade-left" data-aos-delay="200">
          <div class="pub-img-wrap">
            <i class="fa-solid fa-wand-magic-sparkles pub-img-icon"></i>
          </div>
          <div class="pub-content">
            <span class="pub-abbr">TCSVT 2025</span>
            <p class="pub-title">Latent Diffusion-Guided Feature Inpainting for Occluded Person Re-Identification With Hybrid Re-Ranking</p>
            <p class="pub-authors">Pratyay Dutta, Bir Bhanu</p>
            <p class="pub-abstract">Our De-Occluder (DDO) uses AI to "fill in" hidden parts of a person's image, allowing for accurate identification even when someone is partially blocked. Combined with a smart re-ranking system, it achieves state-of-the-art results in identifying people through dense crowds.</p>
          </div>
          <span class="pub-year">2025</span>
        </a>

        <a href="https://ieeexplore.ieee.org/abstract/document/10094009" target="_blank" rel="noopener noreferrer" class="pub-item" data-aos="fade-left" data-aos-delay="200">
          <div class="pub-img-wrap">
            <i class="fa-solid fa-syringe pub-img-icon"></i>
          </div>
          <div class="pub-content">
            <span class="pub-abbr">TCBB 2022</span>
            <p class="pub-title">Hierarchical Vaccine Allocation based on Epidemiological and Behavioral Considerations</p>
            <p class="pub-authors">Satyaki Roy, Pratyay Dutta, Preetam Ghosh</p>
            <p class="pub-abstract">An optimized hierarchical vaccine distribution strategy incorporating epidemiological and behavioral factors with clustering-based zone allocation for improved vaccine redistribution across demographics.</p>
          </div>
          <span class="pub-year">2022</span>
        </a>

        <a href="https://ieeexplore.ieee.org/abstract/document/9669682" target="_blank" rel="noopener noreferrer" class="pub-item" data-aos="fade-left" data-aos-delay="100">
          <div class="pub-img-wrap">
            <i class="fa-solid fa-virus pub-img-icon"></i>
          </div>
          <div class="pub-content">
            <span class="pub-abbr">BIBM 2021</span>
            <p class="pub-title">Generalizable Multi-Vaccine Distribution Strategy based on Demographic and Behavioral Heterogeneity</p>
            <p class="pub-authors">Satyaki Roy, Pratyay Dutta, Preetam Ghosh</p>
            <p class="pub-abstract">A generalizable multi-vaccine distribution strategy using linear optimization and clustering algorithms to address demographic and behavioral heterogeneity across geographic zones.</p>
          </div>
          <span class="pub-year">2021</span>
        </a>

      </div>
    </div>

    <!-- ── Experience ───────────────────────────────────────────────────── -->
    <div id="experience" class="timeline-section" data-aos="fade-up">
      <h3>Experience</h3>
      <div class="timeline">
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="100">
          <span class="timeline-year">2023 –<br>Present</span>
          <div class="timeline-content">
            <p class="timeline-title">Research Assistant</p>
            <p class="timeline-org">University of California, Riverside</p>
            <p class="timeline-desc">Conducting research under Dr. Bir Bhanu on event-based vision with anisotropic heat diffusion, virtual cloth try-off using Stable Diffusion, and latent diffusion-guided feature inpainting for occluded person re-identification.</p>
          </div>
        </div>
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="200">
          <span class="timeline-year">Jun –<br>Aug 2022</span>
          <div class="timeline-content">
            <p class="timeline-title">Research Intern</p>
            <p class="timeline-org">Dalhousie University, Canada</p>
            <p class="timeline-desc">Built a predictive modeling pipeline on Lichess chess data and trained a PPO-based RL agent capable of defeating amateur players below a target FIDE rating, under Dr. Yannick Marchand.</p>
          </div>
        </div>
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="300">
          <span class="timeline-year">Jun 2020 –<br>Nov 2021</span>
          <div class="timeline-content">
            <p class="timeline-title">Research Intern</p>
            <p class="timeline-org">Virginia Commonwealth University, USA</p>
            <p class="timeline-desc">Optimized multi-vaccine distribution strategies using linear programming and clustering; work resulted in publications at IEEE BIBM 2021 and IEEE/ACM TCBB 2022, under Dr. Preetam Ghosh.</p>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Awards ───────────────────────────────────────────────────────── -->
    <div class="timeline-section" data-aos="fade-up">
      <h3>Awards &amp; Honors</h3>
      <div class="timeline">
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="100">
          <span class="timeline-year">2023</span>
          <div class="timeline-content">
            <p class="timeline-title">Dean's Fellowship</p>
            <p class="timeline-org">University of California, Riverside</p>
            <p class="timeline-desc">Awarded for outstanding research acumen upon admission. Acceptance rate: 15%.</p>
          </div>
        </div>
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="200">
          <span class="timeline-year">2020</span>
          <div class="timeline-content">
            <p class="timeline-title">MITACS Fellowship</p>
            <p class="timeline-org">MITACS Canada</p>
            <p class="timeline-desc">Funded summer research internship at Dalhousie University, Canada. Acceptance rate: 18%.</p>
          </div>
        </div>
        <div class="timeline-item" data-aos="fade-right" data-aos-delay="300">
          <span class="timeline-year">2019</span>
          <div class="timeline-content">
            <p class="timeline-title">Bishop Thoburn Award — Student of the Year</p>
            <p class="timeline-org">Calcutta Boys' School</p>
            <p class="timeline-desc">Recognized for outstanding achievement in academics, sports, and extracurricular activities. Awarded to 1 in 120 students.</p>
          </div>
        </div>
      </div>
    </div>

    <div id="skills" class="skills-section skills-section-premium" data-aos="fade-up">
      <div class="section-header reveal-up">
        <div class="section-label">Skills</div>
        <h3 class="section-title">Capabilities</h3>
        <div class="section-rule"></div>
      </div>

      <div class="skills-layout">
        <div class="skills-category reveal-up" style="--delay:0s">
          <div class="skills-cat-header">
            <span class="skills-cat-num" aria-hidden="true">01</span>
            <span class="skills-cat-title">Technical Software</span>
          </div>
          <div class="skills-grid software-grid">
            {% assign software_items = 'Python|MATLAB|Java|C/C++|SQL|PyTorch|TensorFlow|OpenCV|Pandas|NumPy|Matplotlib|Git|Docker|Google Cloud Platform|VS Code|PyCharm|Virtual Environments|CUDA DDP/FSDP' | split: '|' %}
            {% for skill in software_items %}
              <div class="skill-box" tabindex="0" role="button" aria-label="{{ skill }}">
                <div class="skill-thumb"><i class="fa-solid fa-microchip"></i></div>
                <div class="skill-info">
                  <div class="skill-name">{{ skill }}</div>
                  <div class="skill-desc">Applied in research workflows, model development, evaluation pipelines, and production-scale experimentation.</div>
                </div>
              </div>
            {% endfor %}
          </div>
        </div>

        <div class="skills-category reveal-up" style="--delay:0.1s">
          <div class="skills-cat-header">
            <span class="skills-cat-num" aria-hidden="true">02</span>
            <span class="skills-cat-title">Languages</span>
          </div>
          <div class="languages-bars">
            <div class="lang-item">
              <div class="lang-header"><span class="lang-name">English</span><span class="lang-pct">99%</span></div>
              <div class="lang-bar"><div class="lang-fill" style="--w:99%"></div></div>
            </div>
            <div class="lang-item">
              <div class="lang-header"><span class="lang-name">Bengali</span><span class="lang-pct">98%</span></div>
              <div class="lang-bar"><div class="lang-fill" style="--w:98%"></div></div>
            </div>
            <div class="lang-item">
              <div class="lang-header"><span class="lang-name">Hindi</span><span class="lang-pct">67%</span></div>
              <div class="lang-bar"><div class="lang-fill" style="--w:67%"></div></div>
            </div>
            <div class="lang-item">
              <div class="lang-header"><span class="lang-name">German</span><span class="lang-pct">11.1%</span></div>
              <div class="lang-bar"><div class="lang-fill" style="--w:11.1%"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div id="projects" class="home-projects-section projects-section-premium" data-aos="fade-up">
      <div class="section-header reveal-up">
        <div class="section-label">Projects</div>
        <h3 class="section-title">Featured Work</h3>
        <div class="section-rule"></div>
      </div>

      <div class="projects-grid uniform-project-grid">
        {% assign sorted_projects = site.projects | sort: 'importance' %}
        {% for project in sorted_projects %}
          {% assign idx = forloop.index %}
          {% assign project_bg = 'project-bg--p' | append: idx %}
          {% assign cat_label = project.chapter_sub | split: ' · ' | first | default: 'Research' %}

          <a href="{{ project.url | relative_url }}" class="project-card reveal-up">
            <div class="project-card-bg {{ project_bg }}"></div>
            <div class="project-card-overlay"></div>
            <div class="project-card-content">
              <span class="project-number">0{{ forloop.index }}</span>
              <div class="project-category">{{ cat_label }}</div>
              <h4 class="project-name">{{ project.title }}</h4>
              <p class="project-tagline">{{ project.description }}</p>
              <div class="project-meta">
                <span>Details</span>
                {% if project.github %}
                  <span>GitHub</span>
                {% endif %}
              </div>
              <div class="project-arrow" aria-hidden="true">→</div>
            </div>
          </a>
        {% endfor %}
      </div>
    </div>

    <!-- ── Contact Form ─────────────────────────────────────────────────── -->
    <!--
      SETUP: Go to https://formspree.io → create a free account → New Form → copy the form ID.
      Replace "YOUR_FORMSPREE_ID" below with it (e.g. "xpzvwgpk").
      Formspree will forward every submission to pdutt005@ucr.edu.
    -->
    <div id="contact" class="home-contact-section reveal-up" style="--delay:0s">
      <div class="contact-inner">
        <div class="section-header">
          <div class="section-label">Contact</div>
          <h3 class="section-title">Get in Touch</h3>
          <div class="section-rule"></div>
        </div>
        <p class="contact-subtitle">
          Have a question, collaboration idea, or just want to say hello?<br>
          Fill in the form and I'll get back to you.
        </p>

        <form
          class="contact-form"
          action="https://formspree.io/f/mnjgwejr"
          method="POST"
        >
          <input type="hidden" name="_subject" value="Portfolio contact from form">
          <!-- honeypot anti-spam -->
          <input type="text" name="_gotcha" style="display:none">

          <div class="cf-row">
            <div class="cf-field">
              <label class="cf-label" for="cf-name">Your Name <span class="cf-req">*</span></label>
              <input class="cf-input" id="cf-name" type="text" name="name" placeholder="Full name" required>
            </div>
            <div class="cf-field">
              <label class="cf-label" for="cf-email">Email Address <span class="cf-req">*</span></label>
              <input class="cf-input" id="cf-email" type="email" name="email" placeholder="your@email.com" required>
            </div>
          </div>

          <div class="cf-row">
            <div class="cf-field">
              <label class="cf-label" for="cf-affiliation">Affiliation / Organization</label>
              <input class="cf-input" id="cf-affiliation" type="text" name="affiliation" placeholder="University, company, or personal">
            </div>
            <div class="cf-field">
              <label class="cf-label" for="cf-topic">Topic <span class="cf-req">*</span></label>
              <select class="cf-input cf-select" id="cf-topic" name="topic" required>
                <option value="" disabled selected>— Select a topic —</option>
                <option>Research Collaboration</option>
                <option>Internship / Job Opportunity</option>
                <option>Project Feedback</option>
                <option>General Enquiry</option>
                <option>Other</option>
              </select>
            </div>
          </div>

          <div class="cf-field cf-field--full">
            <label class="cf-label" for="cf-message">Message <span class="cf-req">*</span></label>
            <textarea class="cf-input cf-textarea" id="cf-message" name="message" rows="5" placeholder="Tell me what's on your mind…" required></textarea>
          </div>

          <button class="cf-submit" type="submit">
            <i class="fa-solid fa-paper-plane"></i>
            Send Message
          </button>
        </form>
      </div>
    </div>

    <!-- ── Signature / Contact ───────────────────────────────────────────── -->
    <div class="home-footer-section" data-aos="fade-up">
      <h2 class="home-footer-name">{{ site.first_name }}{% if site.middle_name %} {{ site.middle_name }}{% endif %} {{ site.last_name }}</h2>
      <p class="home-footer-tagline">
        Ph.D. candidate in Computer Science, building vision systems at the intersection of physics and deep learning.
      </p>
      <div class="hero-social-boxes home-footer-links">
        {% assign socials = site.data.socials %}
        {% if socials.github_username %}
          <a class="hero-social-link" href="https://github.com/{{ socials.github_username }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-github"></i> GitHub
          </a>
        {% endif %}
        {% if socials.linkedin_username %}
          <a class="hero-social-link" href="https://www.linkedin.com/in/{{ socials.linkedin_username }}" target="_blank" rel="noopener noreferrer">
            <i class="fa-brands fa-linkedin"></i> LinkedIn
          </a>
        {% endif %}
        {% if socials.email %}
          <a class="hero-social-link" href="mailto:{{ socials.email }}">
            <i class="fa-solid fa-envelope"></i> Email
          </a>
        {% endif %}
      </div>
    </div>

</div>

<script>
  (function () {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const el = entry.target;

          el.querySelectorAll('.gpa-arc').forEach((arc) => {
            const target = arc.dataset.offset;
            if (target) {
              setTimeout(() => {
                arc.style.strokeDashoffset = target;
              }, 150);
            }
          });

          el.querySelectorAll('.score-fill, .lang-fill').forEach((bar) => {
            setTimeout(() => {
              bar.classList.add('animated');
            }, 220);
          });

          observer.unobserve(el);
        });
      },
      { threshold: 0.2, rootMargin: '0px 0px -50px 0px' }
    );

    document
      .querySelectorAll('.education-showcase-section, .skills-section-premium, .projects-section-premium')
      .forEach((el) => observer.observe(el));
  })();
</script>
